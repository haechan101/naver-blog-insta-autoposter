drafts/
images/

# ── 실행 환경 ───────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo

# ── 외부 실행 파일 (cloudflared 등, 공식 배포처에서 직접 받아 넣음) ──
tools/

# ── 빌드 부산물 ─────────────────────────────────────
app_*.ico
*.log

